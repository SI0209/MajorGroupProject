<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="DrivingSchoolWebsite.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Araf's Driving School</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
     <!-- Link to your CSS file -->
    <link runat="server" href="~/Content/style.css" rel="stylesheet" type="text/css" />
    <link runat="server" href="~/Content/contactus.css" rel="stylesheet" type="text/css" />
    <link runat="server" href="~/Content/services.css" rel="stylesheet" type="text/css" />
    <link runat="server" href="~/Content/styles.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">



    <link runat="server" href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <link rel="stylesheet" 
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    .body-content {
    width: 100%;
    padding: 0;
    margin: 0;
}

    /* Chat button */
#chatbot-button {
    position: fixed;
    bottom: 25px;
    right: 25px;
    background: #0078d7;
    color: white;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    cursor: pointer;
    z-index: 9999;
}

/* Chat window */
#chatbot-window {
    position: fixed;
    bottom: 100px;
    right: 25px;
    width: 320px;
    height: 450px;
    background: white;
    border-radius: 10px;
    display: none;
    flex-direction: column;
    box-shadow: 0 0 12px rgba(0,0,0,0.2);
    z-index: 9999;
}

#chatbot-header {
    padding: 12px;
    background: #0078d7;
    color: white;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
}

#chatbot-messages {
    padding: 10px;
    overflow-y: auto;
}

/* FAQ Styles */
.faq-category {
    padding: 10px;
    background: #eee;
    margin-top: 8px;
    border-radius: 5px;
    cursor: pointer;
}

.faq-questions {
    margin-left: 10px;
    margin-top: 5px;
}

.faq-question {
    padding: 6px;
    background: #f7f7f7;
    margin: 5px 0;
    border-radius: 4px;
    cursor: pointer;
}

.faq-answer {
    padding: 8px;
    background: #fff;
    border-left: 3px solid #0078d7;
    margin-bottom: 8px;
    border-radius: 4px;
}

 
</style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/"><img runat="server" src="~/Images/Logo_Transparent.png" width="275" height="50" /> </a>

                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <!--Admin Private Pages -->
                        <li class="nav-item"><a class="nav-link" runat="server" id="adminLink" visible="false"  href="~/Admin/AdminPage">ADMIN</a></li>
                        <!-- <li><a class="nav-link" runat="server" id="UnavSlotLink"  href="~/Admin/UnavailableSlots.aspx" onprerender="UnavailableSlots_PreRender">Unavailable Slots</a></li>-->
                        <li><a class="nav-link" runat="server" id="ViewLessonScheduleLink"  href="~/Admin/ViewLessonSchedule.aspx" onprerender="ViewLessonSchedule_PreRender">LESSON SCHEDULE </a></li>
                        <li><a class="nav-link" runat="server" id="ViewReportsLink"  href="~/Admin/ViewReports.aspx" onprerender="ViewReports_PreRender">VIEW REPORT </a></li>
                        <li><a class="nav-link" runat="server" id="ReportTwo"  href="~/Admin/ReportTwo.aspx" onprerender="ReportTwo_PreRender">ANALYTICS REPORT </a></li>
                        <li><a class="nav-link" runat="server" id="ReportThree"  href="~/Admin/ReportThree.aspx" onprerender="ReportThree_PreRender">LEARNER AND SUBURB REPORT </a></li>










                       
                         <!--Client Private Pages -->
                        <li class="nav-item"><a class="nav-link" runat="server" id="clientLink" visible="false"  href="~/Client/ClientPage">CLIENT</a></li>
                       
                        <li><a class="nav-link" runat="server" id="addReviewLink"  href="~/PrivatePages/AddReview.aspx" onprerender="addReviewLink_PreRender">ADD REVIEW</a></li>
                        <li><a class="nav-link" runat="server" id="BookOnlineLink"  href="~/Client/ClientBookingOnline.aspx" onprerender="BookOnline_PreRender">BOOK ONLINE</a></li>
                        <li><a class="nav-link" runat="server" id="ClientViewLessonLink"  href="~/Client/ClientViewLessonSchedule.aspx" onprerender="ClientViewLesson_PreRender">CLIENT LESSON SCHEDULE</a></li>
                        <li><a class="nav-link" runat="server" id="RescheduleBookingLink"  href="~/Client/RescheduleBooking.aspx" onprerender="RescheduleBooking_PreRender">RESCHEDULE BOOKING</a></li>

                        <!-- Instructor Pages-->
                        <li class="nav-item"><a class="nav-link" runat="server" id="instructorLink" visible="false"  href="~/Instructor/InstructorPage">INSTRUCTOR</a></li>
                         <!--<li><a class="nav-link" runat="server" id="UnavSlotInstrucLink"  href="~/Instructor/InstructorUnvailableDate.aspx" onprerender="InstructorUnvailableDate_PreRender">Unavailable Slots Instructor</a></li> -->

                        <li><a class="nav-link" runat="server" id="InstrucViewLessonScheduleLink"  href="~/Instructor/InstructorViewLessonSchedule.aspx" onprerender="InstructorViewLessonSchedule_PreRender"> VIEW LESSON SCHEDULE</a></li>

                        <!--Public Pages 
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Default.aspx">Home</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public Pages/Services.aspx">Services</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/About.aspx">About Us</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Contact.aspx">Contact</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public Pages/BookOnline.aspx">Book Online</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public Pages/Review.aspx">Review</a></li>
                        -->



                    </ul>
                    <asp:LoginView runat="server" id="loginView" ViewStateMode="Disabled">
                        <AnonymousTemplate>
                            <ul class="navbar-nav navbar-right">
                                <!-- Public Pages -->
                                <li class="nav-item"><a class="nav-link" runat="server" href="~/Default.aspx">HOME</a></li>
                                <li class="nav-item"><a class="nav-link" runat="server" href="~/PublicPages/Services.aspx">SERVICES</a></li>
                                <li class="nav-item"><a class="nav-link" runat="server" href="~/About.aspx">ABOUT US</a></li>
                                <li class="nav-item"><a class="nav-link" runat="server" href="~/Contact.aspx">CONTACT US</a></li>
                                <li class="nav-item"><a class="nav-link" runat="server" href="~/PublicPages/BookOnline.aspx">BOOK ONLINE</a></li>
                                <li class="nav-item"><a class="nav-link" runat="server" href="~/PublicPages/Review.aspx">REVIEW</a></li>
        
                                <li><a runat="server" class="nav-link" href="~/Account/Register">REGISTER</a></li>
                                <li><a runat="server" class="nav-link" href="~/Account/Login">LOG IN</a></li>
                            </ul>
                        </AnonymousTemplate>
                        <LoggedInTemplate>
                            <ul class="navbar-nav navbar-right">
                                <li><a runat="server" class="nav-link" href="~/Account/Manage" title="Manage your account">Hello, <%: Context.User.Identity.GetUserName()  %> !</a></li>
                             
                                <li>
                                    <asp:LoginStatus runat="server" CssClass="nav-link" LogoutAction="Redirect" LogoutText="Log off" LogoutPageUrl="~/" OnLoggingOut="Unnamed_LoggingOut" />
                                </li>
                            </ul>
                        </LoggedInTemplate>
                    </asp:LoginView>
                </div>
            </div>
        </nav>
        <div class="body-content">
    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>
            <footer class="footer bg-dark text-white py-4">
                <div class="container text-center">
                    <p>&copy; <%: DateTime.Now.Year %> Araf's Driving School. All rights reserved.</p>
                </div>
            </footer>

<!-- Chatbot Window -->
<        <div id="chatbot-window">
            <div id="chatbot-header">
                Araf's Driving School Assistant
        <span id="chatbot-close">✖</span>
            </div>

            <div id="chatbot-messages"></div>
        </div>
                <script src='//uae.fw-cdn.com/40335159/209988.js' chat='true'></script>
    </form>
</body>
</html>
